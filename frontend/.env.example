# Frontend configuration (copy to .env.local for development).
# Leave empty in development: Vite proxies /api to http://localhost:8080.

# API base URL used by the built app and Android builds.
# Local device (browser): http://localhost:8080
# Android emulator:       http://10.0.2.2:8080
# Physical phone:         http://<your-computer-LAN-IP>:8080
VITE_API_BASE_URL=http://localhost:8080
