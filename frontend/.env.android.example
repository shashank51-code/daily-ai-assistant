# Copy to .env.android (or .env.android.local) and set the backend URL that the
# packaged Android app will call. Loaded by `npm run android:build` (vite --mode android).
#
# The URL must be reachable FROM THE PHONE, not from your computer:
# - Android emulator:  http://10.0.2.2:8080
# - Physical phone:    http://<your-computer-LAN-IP>:8080
# - Production:        https://api.your-domain.example  (HTTPS is required for release)
#
# Never put backend secrets (AI_API_KEY, DB_PASSWORD, ADMIN_API_KEY) in this file:
# everything under VITE_ is compiled into the APK and readable by anyone.

VITE_API_BASE_URL=http://10.0.2.2:8080
